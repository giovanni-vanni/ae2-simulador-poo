sequenceDiagram
    participant T as Test
    participant S as Simulador
    participant P as Proceso
    participant M as Memoria
    participant A as IPoliticaAsignacion
    participant RR as PlanificadorRoundRobin

    T->>S: registrarProceso(pid, memoria, cpuTotal)
    S->>P: crear Proceso
    S->>S: agregar a pendientes

    T->>S: tick()
    S->>S: admitirPendientes()

    S->>M: asignar(proceso)
    M->>A: seleccionar(bloques, tamanio)
    A-->>M: indice de bloque

    alt hay bloque suficiente
        M->>M: ocupar(indice, proceso)
        M-->>S: true
        S->>P: ponerListo()
        S->>RR: encolar(proceso)
    else no hay bloque suficiente
        M-->>S: false
        S->>P: esperarMemoria()
    end
