classDiagram
direction TB

class ISimulador {
    <<interface>>
    +registrarProceso(pid, memoria, cpuTotal, evento)
    +tick()
    +consultarProceso(pid)
    +obtenerEstado()
    +obtenerMetricas()
    +obtenerPolitica()
}

class Simulador {
    -memoria: Memoria
    -planificador: PlanificadorRoundRobin
    -procesos: Proceso[]
    -pendientes: Proceso[]
    -bloqueados: Proceso[]
    -terminados: Proceso[]
    -tickActual: number
    -ticksCPUOcupada: number
    +registrarProceso(pid, memoria, cpuTotal, evento)
    +tick()
    +consultarProceso(pid)
    +obtenerEstado()
    +obtenerMetricas()
    +obtenerPolitica()
    -admitirPendientes()
    -finalizar(proceso)
}

class IGestionMemoria {
    <<interface>>
    +asignar(proceso)
    +liberar(pid)
    +obtenerBloques()
    +memoriaLibre()
    +mayorBloqueLibre()
    +ocupacion()
}

class Memoria {
    -total: number
    -nombrePolitica: NombrePolitica
    -politica: IPoliticaAsignacion
    -bloques: BloqueMemoria[]
    +asignar(proceso)
    +liberar(pid)
    +obtenerBloques()
    +memoriaLibre()
    +mayorBloqueLibre()
    +ocupacion()
    +getTotal()
    +getNombrePolitica()
    -ocupar(indice, proceso)
    -coalescer()
}

class BloqueMemoria {
    -inicio: number
    -tamanio: number
    -pid: string
    +estaLibre()
    +getInicio()
    +getTamanio()
    +getPid()
    +ampliar(cantidad)
    +vista()
}

class IPoliticaAsignacion {
    <<interface>>
    +seleccionar(bloques, tamanio)
}

class FirstFit {
    +seleccionar(bloques, tamanio)
}

class BestFit {
    +seleccionar(bloques, tamanio)
}

class WorstFit {
    +seleccionar(bloques, tamanio)
}

class IPlanificadorCPU {
    <<interface>>
    +encolar(proceso)
    +ejecutarTick()
    +actualizarBloqueados(procesos)
    +obtenerListos()
    +obtenerCPU()
    +obtenerCambiosContexto()
}

class PlanificadorRoundRobin {
    -quantum: number
    -listos: Proceso[]
    -cpu: Proceso
    -cambiosContexto: number
    +encolar(proceso)
    +actualizarBloqueados(procesos)
    +ejecutarTick()
    +obtenerListos()
    +obtenerCPU()
    +obtenerCambiosContexto()
    -despachar()
    -resolverResultado(proceso, resultado)
}

class Proceso {
    -pid: string
    -memoria: number
    -cpuTotal: number
    -cpuRestante: number
    -estado: EstadoProceso
    -quantumConsumido: number
    -bloqueoRestante: number
    -cpuConsumida: number
    -eventoES: EventoES
    -eventoDisparado: boolean
    +configurarEntradaSalida(despuesDe, duracion)
    +esperarMemoria()
    +ponerListo()
    +comenzarEjecucion()
    +consumirCPU()
    +bloquear()
    +actualizarBloqueo()
    +terminar()
    +reiniciarQuantum()
    +debeBloquearse()
    +getPid()
    +getMemoria()
    +getCpuRestante()
    +getEstado()
    +vista()
}

class EstadoProceso {
    <<enumeration>>
    Nuevo
    EsperandoMemoria
    Listo
    Ejecutando
    Bloqueado
    Terminado
}

ISimulador <|.. Simulador
IGestionMemoria <|.. Memoria
IPlanificadorCPU <|.. PlanificadorRoundRobin
IPoliticaAsignacion <|.. FirstFit
IPoliticaAsignacion <|.. BestFit
IPoliticaAsignacion <|.. WorstFit
Simulador "1" *-- "1" Memoria : contiene
Simulador "1" *-- "1" PlanificadorRoundRobin : contiene
Simulador "1" *-- "0..*" Proceso : gestiona
Memoria "1" *-- "1..*" BloqueMemoria : contiene
Memoria --> IPoliticaAsignacion : utiliza
PlanificadorRoundRobin "1" --> "0..*" Proceso : planifica
Memoria --> Proceso : asigna memoria
Proceso --> EstadoProceso : tiene estado
