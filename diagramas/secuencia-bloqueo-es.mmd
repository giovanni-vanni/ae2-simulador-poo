sequenceDiagram
    participant T as Test
    participant S as Simulador
    participant RR as PlanificadorRoundRobin
    participant P as Proceso

    T->>S: registrarProceso(pid, memoria, cpuTotal, eventoES)

    T->>S: tick()
    S->>RR: ejecutarTick()
    RR->>P: consumirCPU()

    P-->>RR: debeBloquearse() = true
    RR->>P: bloquear()
    RR-->>S: proceso bloqueado
    S->>S: agregar a bloqueados

    Note over P: Conserva la memoria asignada

    T->>S: tick()
    S->>RR: actualizarBloqueados(bloqueados)
    RR->>P: actualizarBloqueo()

    alt bloqueoRestante > 0
        P-->>RR: false
        RR-->>S: sigue bloqueado
    else bloqueoRestante = 0
        P-->>RR: true
        RR->>P: ponerListo()
        RR->>RR: encolar(proceso)
        RR-->>S: proceso desbloqueado
    end
